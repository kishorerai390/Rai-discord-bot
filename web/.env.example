# Voicelink Web — Environment Variables
# Copy this to .env and fill in your values

# ── Discord OAuth2 ─────────────────────────────────────────────────
DISCORD_CLIENT_ID=your_bot_client_id_here
DISCORD_CLIENT_SECRET=your_bot_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:8080/callback

# ── Session ────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-random-string-in-production

# ── Server ─────────────────────────────────────────────────────────
PORT=8080
ENVIRONMENT=development   # 'development' | 'production'

# ── Spotify (for Spotify link resolution) ─────────────────────────
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# ── Discord Support Invite ─────────────────────────────────────────
DISCORD_SUPPORT_INVITE=https://discord.gg/your-invite-code

# ── GitHub ────────────────────────────────────────────────────────
GITHUB_URL=https://github.com/your-username/your-repo

