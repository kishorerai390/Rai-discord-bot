# ============================================================
# MusicMaid (Neko Songs) — Dedicated Discord Music Bot & Web Platform
# ============================================================

# 1. Discord Bot Token
# Obtain from https://discord.com/developers/applications
# (Ensure Message Content and Voice State intents are enabled)
MUSIC_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# 2. Database Path
MUSIC_DATABASE_PATH=data/music.db

# 3. Web Platform & Server Settings
PORT=8080
LOG_LEVEL=INFO

# 4. Slash Command Sync ('global' or 'guild')
COMMAND_SYNC_MODE=global
TEST_GUILD_ID=

# 5. Public Website & Web Platform URL
# Configure your authoritative production URL (custom domain or branded Render subdomain)
# e.g., https://musicmaid.bot or https://musicmaid.onrender.com
PUBLIC_BASE_URL=https://rai-discord-bot.onrender.com
MUSICMAID_WEBSITE_URL=https://rai-discord-bot.onrender.com
# Optional: dedicated premium plans page URL (defaults to ${PUBLIC_BASE_URL}/premium)
MUSICMAID_PREMIUM_URL=

# 6. Discord OAuth2 Web Authentication
# Get Client ID & Secret from Discord Developer Portal -> OAuth2 -> General
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must match your Discord Developer Portal Redirects: e.g. ${PUBLIC_BASE_URL}/api/auth/callback
DISCORD_REDIRECT_URI=
SESSION_SECRET=

# 7. Payment & Subscriptions (Student Developer Mode: false by default)
# Set PAYMENTS_ENABLED=false to run in Student Developer Showcase Mode (no payment setup required)
# Set PAYMENTS_ENABLED=true when your merchant gateway is verified and approved
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=razorpay

# Razorpay (Recommended for Individual Developers in India: UPI, Cards, NetBanking)
# Keys obtained from: https://dashboard.razorpay.com/app/keys (Test mode: rzp_test_..., Live mode: rzp_live_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PREMIUM_MONTHLY_AMOUNT_INR=199
PREMIUM_YEARLY_AMOUNT_INR=1799

# Stripe (Alternative for International Payments)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
PREMIUM_CURRENCY=INR
PREMIUM_MONTHLY_AMOUNT_CENTS=499
PREMIUM_YEARLY_AMOUNT_CENTS=4999

# 8. YouTube Datacenter Bypass (Optional: Netscape cookies format)
YOUTUBE_COOKIES=


