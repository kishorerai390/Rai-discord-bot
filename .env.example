# Discord Bot Configuration
# Paste your Discord Bot Token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Database Configuration
DATABASE_PATH=data/bot.db

# Logging & Environment
LOG_LEVEL=INFO
BOT_PREFIX=!

# Slash Command Sync Mode: 'global' or 'guild' (set TEST_GUILD_ID if using 'guild' for instant sync)
COMMAND_SYNC_MODE=global
TEST_GUILD_ID=
